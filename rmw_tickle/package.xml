<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rmw_tickle</name>
  <version>0.0.1</version>
  <description>ROS2 RMW implementation using TickLE middleware</description>
  <maintainer email="maintainer@example.com">Maintainer</maintainer>
  <license>GPLv3</license>

  <buildtool_depend>ament_cmake_ros</buildtool_depend>

  <build_depend>rosidl_cmake</build_depend>
  <build_depend>rcutils</build_depend>
  <build_depend>rmw</build_depend>
  <build_depend>rosidl_runtime_c</build_depend>
  <build_depend>rosidl_typesupport_tickle_c</build_depend>
  <build_depend>rcutils</build_depend>
  <build_depend>tracetools</build_depend>

  <exec_depend>rcutils</exec_depend>
  <exec_depend>rmw</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <member_of_group>rmw_implementation_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
